# Отдельный бот из @BotFather (НЕ токен клиентского бота)
BOT_TOKEN=123456:ABC
# Твой Telegram ID (узнать: @userinfobot). Только эти люди получат доступ.
ADMIN_IDS=[123456789]

# Контейнеры, которые нельзя перезапускать из бота (admin-bot защищён всегда)
PROTECTED_CONTAINERS=[]
# Разрешить перезагрузку всего сервера кнопкой (по умолчанию выключено)
ALLOW_HOST_REBOOT=false

# Мониторинг и алерты
MONITOR_INTERVAL=60
RAM_ALERT_PERCENT=90
DISK_ALERT_PERCENT=90
